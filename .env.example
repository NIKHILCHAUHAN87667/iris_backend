# Database: use DATABASE_URL for runtime and DIRECT_URL for Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Supabase Storage (use a private bucket; never expose the service role key to the frontend).
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
SUPABASE_STORAGE_BUCKET=iris-documents

# Qdrant Cloud with Cloud Inference enabled (server-side only).
QDRANT_URL=https://YOUR_CLUSTER_URL
QDRANT_API_KEY=replace_with_qdrant_api_key
QDRANT_COLLECTION=iris_documents
# Qdrant Cloud Inference models used for semantic and BM25 sparse vectors.
QDRANT_DENSE_MODEL=sentence-transformers/all-minilm-l6-v2
QDRANT_SPARSE_MODEL=qdrant/bm25

# AI assistant explanations and summaries (server-side only).
GROQ_API_KEY=replace_with_groq_api_key

# Clerk API and webhook credentials (keep secret keys server-side).
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
ADMIN_SESSION_SECRET=replace_with_a_long_random_server_only_secret
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=irisadmin123
DEMO_ADMIN_DISPLAY_NAME=Admin

# Existing active department ID used when an invitation has no department metadata.
DEFAULT_DEPARTMENT_ID=00000000-0000-0000-0000-000000000000

FRONTEND_ORIGIN=http://localhost:5174
FRONTEND_URL=http://localhost:5174
PORT=3000
